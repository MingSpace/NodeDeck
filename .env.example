# Server
PORT=8080
NODE_ENV=production

# Storage
DATA_DIR=./data

# Auth
INITIAL_PASSWORD=changeme
# SESSION_SECRET 留空即可:首次启动会自动生成强密钥并保存到 data/secret.key,
# 之后启动直接复用。只有想在多实例间共享会话时才需要显式指定(>=16 字符)。
# SESSION_SECRET=please-change-this-to-a-long-random-string-at-least-32-chars

# Public-facing base URL (used in #!MANAGED-CONFIG header and displayed URLs in Web UI)
# 如果你按 docs/deployment.md "安全加固" 给 /sub 加了 nginx 深路径前缀,
# 这里也要带上前缀,例如:https://sub.example.com/aB9xK2pQ7vNm4Lf3
PUBLIC_BASE_URL=https://sub.example.com

# Optional: log level (info | debug | warn | error)
LOG_LEVEL=info
