// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`generator fixtures > clash output matches snapshot 1`] = `
"# Generated by MConvert
# !flag: mihomo
# Profile: example
# Generated at: [TIMESTAMP]
allow-lan: false
mode: rule
log-level: info
ipv6: false
dns:
  enable: true
  nameserver: [119.29.29.29, 223.5.5.5]
proxies:
  - {name: 🇭🇰 HK-01, type: trojan, server: hk.example.com, port: 443, udp: true, tls: true, sni: hk.test, skip-cert-verify: true, password: secret}
  - {name: 🇯🇵 JP-01, type: ss, server: jp.example.com, port: 8388, udp: true, cipher: aes-128-gcm, password: pwd}
proxy-groups:
  - {name: Proxys, type: url-test, proxies: [🇭🇰 HK-01, 🇯🇵 JP-01], url: http://cp.cloudflare.com/generate_204, interval: 600, tolerance: 50, timeout: 5}
  - {name: Manual, type: select, proxies: [Proxys, DIRECT]}
rule-providers:
  cn-direct: {type: http, behavior: domain, url: https://example.com/cn.yaml, path: ./ruleset/cn-direct.yaml, interval: 86400, format: yaml}
  reject-list: {type: http, behavior: classical, url: https://example.com/reject.conf, path: ./ruleset/reject-list.yaml, interval: 86400, format: yaml}
rules:
  - RULE-SET,cn-direct,DIRECT
  - RULE-SET,reject-list,REJECT
  - MATCH,Manual
"
`;

exports[`generator fixtures > surge output matches snapshot 1`] = `
"#!MANAGED-CONFIG https://sub.example.com/sub?profile=example&target=surge&t=fixturetoken interval=86400 strict=false

# Generated by MConvert
# Profile: example
# Generated at: [TIMESTAMP]

[General]
internet-test-url = http://wifi.vivo.com.cn/generate_204
proxy-test-url = http://cp.cloudflare.com/generate_204
test-timeout = 5
ipv6 = false
allow-lan = false
loglevel = notify
exclude-simple-hostnames = true
skip-proxy = 127.0.0.0/8, 192.168.0.0/16, localhost
dns-server = 119.29.29.29, 223.5.5.5
hijack-dns = 8.8.8.8:53

[Proxy]
DIRECT = direct
🇭🇰 HK-01 = trojan, hk.example.com, 443, password=secret, sni=hk.test, skip-cert-verify=true, udp-relay=true
🇯🇵 JP-01 = ss, jp.example.com, 8388, encrypt-method=aes-128-gcm, password=pwd, udp-relay=true

[Proxy Group]
Proxys = url-test,🇭🇰 HK-01,🇯🇵 JP-01,url=http://cp.cloudflare.com/generate_204,interval=600,tolerance=50,timeout=5
Manual = select,Proxys,DIRECT

[Rule]
RULE-SET,https://example.com/cn.yaml,DIRECT
RULE-SET,https://example.com/reject.conf,REJECT
FINAL,Manual
"
`;
