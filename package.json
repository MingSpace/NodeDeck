{
  "name": "nodedeck",
  "version": "1.0.0",
  "private": true,
  "description": "NodeDeck — personal Clash + Surge subscription converter with Web UI",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "concurrently -k -n backend,frontend -c blue,magenta \"pnpm -F backend dev\" \"pnpm -F frontend dev\"",
    "build": "pnpm -r --filter ./frontend... build && pnpm -F backend build",
    "start": "pnpm -F backend start",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -F backend test",
    "test:watch": "pnpm -F backend test:watch"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "eslint": "^9.16.0",
    "@eslint/js": "^9.16.0",
    "typescript-eslint": "^8.18.0",
    "typescript": "^5.7.2"
  }
}
