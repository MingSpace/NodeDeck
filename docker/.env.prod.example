# NodeDeck 生产环境配置示例
# 用法: cp .env.prod.example .env  然后改下面带 ! 的项

# === 镜像 ===
# 默认拉公开仓库 ghcr.io/mingspace/nodedeck;如果你 fork 了改成自己的
IMAGE=ghcr.io/mingspace/nodedeck

# 锁版本(推荐生产用):latest / v0.1.0 / sha-abc1234
# 用 latest 配合 ./update.sh 可以一键升级到最新
IMAGE_TAG=latest

# === 网络 ===
# 容器对宿主机暴露的端口(反代到这个端口)
HOST_PORT=8080

# === 必填:认证 ===
# !! 首次启动用的密码,登录后系统会强制改密
INITIAL_PASSWORD=changeme-please

# !! Session 加密密钥,必须 >= 32 字符,用 `openssl rand -base64 48` 生成
SESSION_SECRET=please-change-this-to-a-long-random-string-at-least-32-chars

# !! 对外公网 URL,会写到 Surge 的 #!MANAGED-CONFIG 头里 + Web UI 显示
# 一定要是反代后客户端真实能访问的地址,否则订阅自动更新会失败
PUBLIC_BASE_URL=https://sub.example.com

# === 可选 ===
LOG_LEVEL=info
